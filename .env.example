# Neon Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth
JWT_SECRET=your-random-64-char-secret-here

# Square POS & Payments
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# Email notifications (optional — Resend)
RESEND_API_KEY=
OWNER_EMAIL=owner@thestonedchef.ca

# SMS notifications (optional — Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OWNER_PHONE=

# Error monitoring (optional — Sentry)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed at build time to upload source maps (CI / Vercel)
SENTRY_AUTH_TOKEN=
